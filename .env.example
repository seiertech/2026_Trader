# ─────────────────────────────────────────────────────────────
# Trading Command — environment template  (TC-SPEC-001 §128, §129)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# --- Operating mode (TC-SPEC-001 Part XVIII). MUST default to SHADOW. ---
# One of: OFF | SHADOW | PAPER | LIVE_LIMITED | LIVE_AUTO
TC_MODE=SHADOW

# --- Reference unit (TC-ADR-016; NOT a capital base to compound, NOT a target) ---
# £250 exists only to express risk-per-trade, R and expectancy legibly (§74).
# There is NO capital return target in V1 (§0 Prime Directive, §75, TC-ADR-017).
TC_REFERENCE_UNIT_GBP=250
TC_SHADOW_REFERENCE_UNIT_GBP=250

# --- MetaTrader 5 terminal (Windows host / VM — see docs/build/OPEN-QUESTIONS.md OQ-2) ---
# Only required for Phase 1 (live read) and later live execution.
# Not needed for Shadow with the replay/synthetic provider.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Bridge host:port when the MT5 terminal runs on a separate Windows machine/VM.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=18812

# --- AI providers (TC-SPEC-001 §56; selective use per TC-ADR-011) ---
# Leave blank to run fully deterministic (no AI). AI never overrides risk (TC-ADR-012).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TC_AI_DEFAULT_PROVIDER=

# --- Intelligence providers (free-first per TC-ADR-009; adapters per TC-ADR-010) ---
# Most zero-cost sources (BBC/Guardian/GDELT RSS/GKG) need no key.
# Add keys only where a source requires one.
GDELT_ENABLED=true

# --- Storage ---
# Local research DB (Phase 0). Default DuckDB file lives under data/.
TC_DATABASE_URL=duckdb:///data/trading_command.duckdb

# --- Observability ---
TC_LOG_LEVEL=INFO
TC_LOG_FORMAT=json
